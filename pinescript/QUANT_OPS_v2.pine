//@version=5
// ============================================================================
// QUANT OPS v2 — CONFLUÊNCIA + PRICE ACTION + SEMÁFORO  (porte do app web)
// ============================================================================
// FERRAMENTA DE ESTUDO. Não é recomendação de investimento. Opções binárias e
// expirações curtas são de altíssimo risco: com payout < 100% a matemática
// favorece a casa, e spread/taxas corroem qualquer edge. Valide em backtest e
// forward test antes de qualquer uso com capital real.
//
// Traz para o TradingView o que o app QUANT OPS faz:
//   • Confluência multi-fator (tendência, EMA200, RSI, ATR, estrutura, MACD,
//     Bollinger, padrão de vela) com pontuação mínima configurável
//   • Portões de contexto: multi-timeframe, sessão forte, distância de S/R
//   • Zonas de Suporte/Resistência com FORÇA por número de toques
//   • LTA / LTB (linhas de tendência automáticas por pivôs)
//   • Estrutura de mercado: HH / HL / LH / LL e CHoCH
//   • Divergências RSI × preço (regulares e ocultas)
//   • SEMÁFORO: ENTRAR / ESPERAR / EVITAR — a decisão única, no painel
//   • Selo de qualidade A / B / C
//   • ALERTAS NATIVOS do TradingView (rodam no servidor: chegam no celular
//     mesmo com o app fechado — vantagem real sobre o app web)
//
// VANTAGEM: alertas server-side.  LIMITE: o TradingView não roda a IA de
// otimização nem o registro de calibração do app — isso continua no app web.
// ============================================================================

indicator("QUANT OPS v2 — Confluência + Price Action [Estudo]", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 100)

// ---------------------------------------------------------------------------
// INPUTS — FATORES DE CONFLUÊNCIA
// ---------------------------------------------------------------------------
gF = "① Fatores de confluência"
useTend   = input.bool(true,  "Tendência (EMA rápida × lenta)", group = gF)
emaRLen   = input.int(9,   "EMA rápida", minval = 1, group = gF)
emaLLen   = input.int(21,  "EMA lenta",  minval = 1, group = gF)
useEma200 = input.bool(true,  "EMA 200 (viés macro)", group = gF)
ema200Len = input.int(200, "Período EMA 200", minval = 1, group = gF)
useRsi    = input.bool(true,  "RSI (reversão de sobrevenda/sobrecompra)", group = gF)
rsiLen    = input.int(14,  "Período RSI", minval = 1, group = gF)
rsiSv     = input.int(30,  "Sobrevenda", minval = 1, maxval = 50, group = gF)
rsiSc     = input.int(70,  "Sobrecompra", minval = 50, maxval = 99, group = gF)
useAtr    = input.bool(true,  "ATR (volatilidade acima da média)", group = gF)
atrLen    = input.int(14,  "Período ATR", minval = 1, group = gF)
atrMedLen = input.int(50,  "Média do ATR", minval = 1, group = gF)
useEstr   = input.bool(true,  "Estrutura (rompimento de topo/fundo)", group = gF)
estrLook  = input.int(20,  "Lookback da estrutura", minval = 2, group = gF)
useMacd   = input.bool(false, "MACD (momentum)", group = gF)
useBoll   = input.bool(false, "Bollinger (reversão nas bandas 2σ)", group = gF)
usePadrao = input.bool(false, "Padrão de vela (engolfo / martelo)", group = gF)

gC = "② Confluência"
minScore  = input.int(4, "Mínimo de fatores a favor", minval = 1, maxval = 8, group = gC, tooltip = "Quantos fatores precisam apontar na mesma direção. 4 é o equilíbrio do app.")
cooldown  = input.int(5, "Cooldown (velas entre sinais)", minval = 0, group = gC)
confirmar = input.bool(true, "Só no fechamento da vela", group = gC, tooltip = "Evita sinal que aparece e some durante a formação da vela.")

// ---------------------------------------------------------------------------
// INPUTS — PORTÕES DE CONTEXTO
// ---------------------------------------------------------------------------
gP = "③ Portões (contexto)"
useMtf    = input.bool(true, "Multi-timeframe: só a favor do TF maior", group = gP)
tfMaior   = input.timeframe("", "Timeframe maior", group = gP, tooltip = "Vazio = automático (5× o atual).")
useSessao = input.bool(true, "Só nas sessões fortes (Londres/NY)", group = gP)
sessaoStr = input.session("0700-2100", "Janela de sessão (UTC)", group = gP)
useSR     = input.bool(true, "Vetar entrada colada em S/R contrário", group = gP)
srAtrMin  = input.float(0.5, "Distância mínima de S/R (× ATR)", minval = 0.1, step = 0.1, group = gP)
usePA     = input.bool(false, "Price Action: só entrar no TESTE de zona/LT", group = gP, tooltip = "Como o Filtro Price Action do app: CALL perto de suporte/LTA, PUT perto de resistência/LTB.")
paAtrMax  = input.float(0.8, "Distância máxima da zona (× ATR)", minval = 0.1, step = 0.1, group = gP)

// ---------------------------------------------------------------------------
// INPUTS — PRICE ACTION / VISUAL
// ---------------------------------------------------------------------------
gV = "④ Price Action & visual"
pivLen     = input.int(5, "Força do pivô (barras de cada lado)", minval = 2, group = gV)
mostrarZonas = input.bool(true,  "Zonas de S/R (força por nº de toques)", group = gV)
mostrarLT    = input.bool(true,  "LTA / LTB automáticas", group = gV)
mostrarEstr  = input.bool(true,  "Rótulos HH / HL / LH / LL", group = gV)
mostrarDiv   = input.bool(true,  "Divergências RSI × preço", group = gV)
mostrarPainel = input.bool(true, "Painel de decisão (semáforo)", group = gV)
posPainel    = input.string("Superior direito", "Posição do painel", options = ["Superior direito", "Superior esquerdo", "Inferior direito", "Inferior esquerdo"], group = gV)

// ---------------------------------------------------------------------------
// INDICADORES BASE
// ---------------------------------------------------------------------------
emaR   = ta.ema(close, emaRLen)
emaL   = ta.ema(close, emaLLen)
ema200 = ta.ema(close, ema200Len)
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(atrLen)
atrMed = ta.sma(atr, atrMedLen)
[macdLinha, macdSinal, macdHist] = ta.macd(close, 12, 26, 9)
bbBase = ta.sma(close, 20)
bbDesv = ta.stdev(close, 20) * 2.0
bbSup  = bbBase + bbDesv
bbInf  = bbBase - bbDesv

// TF maior automático (≈5× o atual) quando não informado
tfAuto = timeframe.period == "1" ? "5" : timeframe.period == "5" ? "15" : timeframe.period == "15" ? "60" : timeframe.period == "30" ? "120" : timeframe.period == "60" ? "240" : "D"
tfUsado = tfMaior == "" ? tfAuto : tfMaior
emaRHtf = request.security(syminfo.tickerid, tfUsado, ta.ema(close, emaRLen), lookahead = barmerge.lookahead_off)
emaLHtf = request.security(syminfo.tickerid, tfUsado, ta.ema(close, emaLLen), lookahead = barmerge.lookahead_off)
closeHtf = request.security(syminfo.tickerid, tfUsado, close, lookahead = barmerge.lookahead_off)
htfDir  = emaRHtf > emaLHtf ? 1 : emaRHtf < emaLHtf ? -1 : 0

// ---------------------------------------------------------------------------
// FATORES (mesma lógica do app)
// ---------------------------------------------------------------------------
fTendL = emaR > emaL
fTendS = emaR < emaL
fMacroL = close > ema200
fMacroS = close < ema200
fRsiL = ta.crossover(rsi, rsiSv)
fRsiS = ta.crossunder(rsi, rsiSc)
fAtr  = atr > atrMed
maxRec = ta.highest(high[1], estrLook)
minRec = ta.lowest(low[1], estrLook)
fEstrL = close > maxRec
fEstrS = close < minRec
fMacdL = macdHist > 0 and macdHist >= macdHist[1]
fMacdS = macdHist < 0 and macdHist <= macdHist[1]
fBollL = close < bbInf
fBollS = close > bbSup
corpo   = math.abs(close - open)
rangeV  = high - low
engolfoL = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
engolfoS = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
marteloL = rangeV > 0 and (math.min(open, close) - low) > corpo * 2 and close > open
marteloS = rangeV > 0 and (high - math.max(open, close)) > corpo * 2 and close < open
fPadL = engolfoL or marteloL
fPadS = engolfoS or marteloS

// Pontuação
scoreL = (useTend and fTendL ? 1 : 0) + (useEma200 and fMacroL ? 1 : 0) + (useRsi and fRsiL ? 1 : 0) + (useAtr and fAtr ? 1 : 0) + (useEstr and fEstrL ? 1 : 0) + (useMacd and fMacdL ? 1 : 0) + (useBoll and fBollL ? 1 : 0) + (usePadrao and fPadL ? 1 : 0)
scoreS = (useTend and fTendS ? 1 : 0) + (useEma200 and fMacroS ? 1 : 0) + (useRsi and fRsiS ? 1 : 0) + (useAtr and fAtr ? 1 : 0) + (useEstr and fEstrS ? 1 : 0) + (useMacd and fMacdS ? 1 : 0) + (useBoll and fBollS ? 1 : 0) + (usePadrao and fPadS ? 1 : 0)
habilitados = (useTend ? 1 : 0) + (useEma200 ? 1 : 0) + (useRsi ? 1 : 0) + (useAtr ? 1 : 0) + (useEstr ? 1 : 0) + (useMacd ? 1 : 0) + (useBoll ? 1 : 0) + (usePadrao ? 1 : 0)
alvo = math.min(minScore, habilitados)

// ---------------------------------------------------------------------------
// PIVÔS · ZONAS S/R COM FORÇA · LTA/LTB · ESTRUTURA
// ---------------------------------------------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float[] topos = array.new_float()
var int[]   toposX = array.new_int()
var float[] fundos = array.new_float()
var int[]   fundosX = array.new_int()
if not na(ph)
    array.push(topos, ph)
    array.push(toposX, bar_index - pivLen)
    if array.size(topos) > 12
        array.shift(topos)
        array.shift(toposX)
if not na(pl)
    array.push(fundos, pl)
    array.push(fundosX, bar_index - pivLen)
    if array.size(fundos) > 12
        array.shift(fundos)
        array.shift(fundosX)

// Força da zona = quantos pivôs caem dentro de ±0.6 ATR do nível
contaToques(arr, nivel, tol) =>
    int n = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - nivel) <= tol
                n += 1
    n

tolZona = atr * 0.6
resistProx = array.size(topos) > 0 ? array.get(topos, array.size(topos) - 1) : na
supProx    = array.size(fundos) > 0 ? array.get(fundos, array.size(fundos) - 1) : na
forcaRes = na(resistProx) ? 0 : contaToques(topos, resistProx, tolZona)
forcaSup = na(supProx)    ? 0 : contaToques(fundos, supProx, tolZona)

// Desenha as zonas como caixas (só a mais recente de cada lado, como no app)
var box zonaRes = na
var box zonaSup = na
if mostrarZonas and barstate.islast
    box.delete(zonaRes)
    box.delete(zonaSup)
    if not na(resistProx)
        corR = forcaRes >= 3 ? color.new(color.red, 82) : color.new(color.red, 92)
        zonaRes := box.new(bar_index - 100, resistProx + tolZona, bar_index + 10, resistProx - tolZona, border_color = color.new(color.red, 45), border_style = line.style_dashed, bgcolor = corR, text = "R " + (forcaRes >= 3 ? "forte" : forcaRes == 2 ? "média" : "fraca") + " · " + str.tostring(forcaRes) + "×", text_color = color.new(color.red, 25), text_size = size.tiny, text_halign = text.align_left)
    if not na(supProx)
        corS = forcaSup >= 3 ? color.new(color.green, 82) : color.new(color.green, 92)
        zonaSup := box.new(bar_index - 100, supProx + tolZona, bar_index + 10, supProx - tolZona, border_color = color.new(color.green, 45), border_style = line.style_dashed, bgcolor = corS, text = "S " + (forcaSup >= 3 ? "forte" : forcaSup == 2 ? "média" : "fraca") + " · " + str.tostring(forcaSup) + "×", text_color = color.new(color.green, 25), text_size = size.tiny, text_halign = text.align_left)

// LTA (fundos ascendentes) e LTB (topos descendentes) — liga os 2 últimos pivôs válidos
var line ltaLinha = na
var line ltbLinha = na
if mostrarLT and barstate.islast
    line.delete(ltaLinha)
    line.delete(ltbLinha)
    if array.size(fundos) >= 2
        f1 = array.get(fundos, array.size(fundos) - 1)
        f0 = array.get(fundos, array.size(fundos) - 2)
        x1 = array.get(fundosX, array.size(fundosX) - 1)
        x0 = array.get(fundosX, array.size(fundosX) - 2)
        if f1 > f0 and x1 > x0
            projLta = f1 + (f1 - f0) / (x1 - x0) * (bar_index + 5 - x1)
            ltaLinha := line.new(x0, f0, bar_index + 5, projLta, color = color.new(color.green, 35), style = line.style_dashed, width = 1)
    if array.size(topos) >= 2
        t1 = array.get(topos, array.size(topos) - 1)
        t0 = array.get(topos, array.size(topos) - 2)
        y1 = array.get(toposX, array.size(toposX) - 1)
        y0 = array.get(toposX, array.size(toposX) - 2)
        if t1 < t0 and y1 > y0
            projLtb = t1 + (t1 - t0) / (y1 - y0) * (bar_index + 5 - y1)
            ltbLinha := line.new(y0, t0, bar_index + 5, projLtb, color = color.new(color.red, 35), style = line.style_dashed, width = 1)

// Rótulos de estrutura HH/HL/LH/LL
if mostrarEstr and not na(ph)
    ehHH = array.size(topos) >= 2 and array.get(topos, array.size(topos) - 1) > array.get(topos, array.size(topos) - 2)
    label.new(bar_index - pivLen, ph, ehHH ? "HH" : "LH", style = label.style_label_down, color = color.new(color.black, 100), textcolor = ehHH ? color.new(color.green, 20) : color.new(color.red, 20), size = size.tiny)
if mostrarEstr and not na(pl)
    ehHL = array.size(fundos) >= 2 and array.get(fundos, array.size(fundos) - 1) > array.get(fundos, array.size(fundos) - 2)
    label.new(bar_index - pivLen, pl, ehHL ? "HL" : "LL", style = label.style_label_up, color = color.new(color.black, 100), textcolor = ehHL ? color.new(color.green, 20) : color.new(color.red, 20), size = size.tiny)

// Estrutura vigente (como definirEstrutura do app): manda o swing mais recente
ultTopoAlto  = array.size(topos)  >= 2 and array.get(topos, array.size(topos) - 1) > array.get(topos, array.size(topos) - 2)
ultFundoAlto = array.size(fundos) >= 2 and array.get(fundos, array.size(fundos) - 1) > array.get(fundos, array.size(fundos) - 2)
semSwings = array.size(topos) < 2 or array.size(fundos) < 2
estruturaTxt = semSwings ? "Indefinida" : ultTopoAlto and ultFundoAlto ? "Alta (HH+HL)" : not ultTopoAlto and not ultFundoAlto ? "Baixa (LH+LL)" : not ultTopoAlto and ultFundoAlto ? "Compressão" : "Expansão"
estruturaDir = estruturaTxt == "Alta (HH+HL)" ? 1 : estruturaTxt == "Baixa (LH+LL)" ? -1 : 0

// ---------------------------------------------------------------------------
// DIVERGÊNCIAS RSI × PREÇO
// ---------------------------------------------------------------------------
// Guarda o preço e o RSI do pivô ANTERIOR de cada lado; compara com o novo.
// REGULAR de baixa: topo mais alto, RSI mais baixo → força se esgotando.
// REGULAR de alta:  fundo mais baixo, RSI mais alto → venda se esgotando.
var float topoAntPreco = na
var float topoAntRsi   = na
var float fundoAntPreco = na
var float fundoAntRsi   = na
bool divBaixa = false
bool divAlta  = false

if not na(ph)
    rsiNoPivo = rsi[pivLen]
    if not na(topoAntPreco) and not na(topoAntRsi)
        divBaixa := ph > topoAntPreco and rsiNoPivo < topoAntRsi
    topoAntPreco := ph
    topoAntRsi   := rsiNoPivo

if not na(pl)
    rsiNoPivo = rsi[pivLen]
    if not na(fundoAntPreco) and not na(fundoAntRsi)
        divAlta := pl < fundoAntPreco and rsiNoPivo > fundoAntRsi
    fundoAntPreco := pl
    fundoAntRsi   := rsiNoPivo

if mostrarDiv and divBaixa
    label.new(bar_index - pivLen, high[pivLen], "div ▼", style = label.style_label_down, color = color.new(color.red, 30), textcolor = color.white, size = size.tiny)
if mostrarDiv and divAlta
    label.new(bar_index - pivLen, low[pivLen], "div ▲", style = label.style_label_up, color = color.new(color.green, 30), textcolor = color.white, size = size.tiny)

// ---------------------------------------------------------------------------
// PORTÕES + SINAL
// ---------------------------------------------------------------------------
naSessao = not useSessao or not na(time(timeframe.period, sessaoStr, "GMT+0"))
mtfOkL = not useMtf or htfDir == 1
mtfOkS = not useMtf or htfDir == -1
// S/R: veta long colado numa resistência acima e short colado num suporte abaixo
srOkL = not useSR or na(resistProx) or (resistProx - close) > atr * srAtrMin
srOkS = not useSR or na(supProx)    or (close - supProx) > atr * srAtrMin
// Price Action: exige o TESTE de uma zona a favor
paOkL = not usePA or (not na(supProx)    and math.abs(close - supProx)    <= atr * paAtrMax)
paOkS = not usePA or (not na(resistProx) and math.abs(close - resistProx) <= atr * paAtrMax)

var int barrasDesde = 999999
barrasDesde := barrasDesde + 1
okFech = not confirmar or barstate.isconfirmed
okCool = barrasDesde >= cooldown

brutoL = habilitados > 0 and scoreL >= alvo and scoreL > scoreS
brutoS = habilitados > 0 and scoreS >= alvo and scoreS > scoreL
sinalL = brutoL and naSessao and mtfOkL and srOkL and paOkL and okFech and okCool
sinalS = brutoS and naSessao and mtfOkS and srOkS and paOkS and okFech and okCool and not sinalL
if sinalL or sinalS
    barrasDesde := 0

// ---------------------------------------------------------------------------
// SELO A/B/C e SEMÁFORO (a decisão única do app)
// ---------------------------------------------------------------------------
dirDom = scoreL >= scoreS ? 1 : -1
forcaOk = (dirDom == 1 ? scoreL : scoreS) >= math.max(1, math.ceil(habilitados * 0.7))
htfOk = dirDom == 1 ? mtfOkL : mtfOkS
srOk  = dirDom == 1 ? srOkL  : srOkS
selo = forcaOk and htfOk and srOk and naSessao ? "A" : (dirDom == 1 ? scoreL : scoreS) >= alvo and srOk and htfOk ? "B" : "C"

temSinal = brutoL or brutoS
paOk = dirDom == 1 ? paOkL : paOkS
mtfContra = useMtf and htfDir != 0 and htfDir == -dirDom

semaforo = not naSessao ? "EVITAR" : mtfContra ? "EVITAR" : (selo == "C" and temSinal) ? "EVITAR" : not temSinal ? "ESPERAR" : not paOk ? "ESPERAR" : selo == "A" ? "ENTRAR" : "ESPERAR"
semCor = semaforo == "ENTRAR" ? color.new(color.green, 15) : semaforo == "EVITAR" ? color.new(color.red, 25) : color.new(color.orange, 25)
motivoSemSinal = "sem confluência (" + str.tostring(scoreL) + " CALL / " + str.tostring(scoreS) + " PUT)"
motivoSeloA = dirDom == 1 ? "CALL ▲ selo A · portões fechados" : "PUT ▼ selo A · portões fechados"
semMotivo = not naSessao ? "fora da sessão forte" : mtfContra ? "contra o TF maior" : not temSinal ? motivoSemSinal : not paOk ? "longe da zona — espere o teste" : selo == "A" ? motivoSeloA : "selo " + selo + " — aguarde grau A"

// ---------------------------------------------------------------------------
// PLOTS
// ---------------------------------------------------------------------------
plot(emaR, "EMA rápida", color = color.new(#3987e5, 0), linewidth = 1)
plot(emaL, "EMA lenta",  color = color.new(#c98500, 0), linewidth = 1)
plot(useEma200 ? ema200 : na, "EMA 200", color = color.new(#9085e9, 0), linewidth = 2)
plotshape(sinalL, "Sinal CALL", shape.triangleup,   location.belowbar, color.new(color.lime, 0), size = size.small)
plotshape(sinalS, "Sinal PUT",  shape.triangledown, location.abovebar, color.new(color.red, 0),  size = size.small)

// ---------------------------------------------------------------------------
// PAINEL DE DECISÃO (semáforo + contexto)
// ---------------------------------------------------------------------------
posicao = posPainel == "Superior direito" ? position.top_right : posPainel == "Superior esquerdo" ? position.top_left : posPainel == "Inferior direito" ? position.bottom_right : position.bottom_left
var table painel = table.new(posicao, 2, 8, bgcolor = color.new(#0a0f18, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

if mostrarPainel and barstate.islast
    table.cell(painel, 0, 0, semaforo, text_color = color.white, bgcolor = semCor, text_size = size.large)
    table.cell(painel, 1, 0, semMotivo, text_color = color.new(color.white, 15), bgcolor = semCor, text_size = size.small)
    table.cell(painel, 0, 1, "Selo",       text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 1, selo + (temSinal ? (dirDom == 1 ? "  ▲ CALL" : "  ▼ PUT") : ""), text_color = selo == "A" ? color.lime : selo == "B" ? color.orange : color.red, text_size = size.small)
    table.cell(painel, 0, 2, "Confluência", text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 2, str.tostring(scoreL) + " CALL · " + str.tostring(scoreS) + " PUT  (mín " + str.tostring(alvo) + "/" + str.tostring(habilitados) + ")", text_color = color.white, text_size = size.small)
    table.cell(painel, 0, 3, "TF maior " + tfUsado, text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 3, htfDir == 1 ? "▲ alta" : htfDir == -1 ? "▼ baixa" : "— neutro", text_color = htfDir == 1 ? color.lime : htfDir == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(painel, 0, 4, "Estrutura", text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 4, estruturaTxt, text_color = estruturaDir == 1 ? color.lime : estruturaDir == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(painel, 0, 5, "Zonas", text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 5, "R " + str.tostring(forcaRes) + "×  ·  S " + str.tostring(forcaSup) + "×", text_color = color.white, text_size = size.small)
    table.cell(painel, 0, 6, "Sessão", text_color = color.gray, text_size = size.small)
    table.cell(painel, 1, 6, naSessao ? "forte ✓" : "fraca ✗", text_color = naSessao ? color.lime : color.red, text_size = size.small)
    table.cell(painel, 0, 7, "⚠ Estudo", text_color = color.new(color.orange, 30), text_size = size.tiny)
    table.cell(painel, 1, 7, "não é recomendação", text_color = color.new(color.orange, 30), text_size = size.tiny)

// ---------------------------------------------------------------------------
// ALERTAS NATIVOS — rodam no servidor do TradingView: chegam no celular mesmo
// com o app fechado (a vantagem que o app web não consegue ter sem servidor).
// ---------------------------------------------------------------------------
alertcondition(sinalL, "CALL — confluência + portões", "QUANT OPS: sinal de CALL em {{ticker}} ({{interval}}) — confira o semáforo antes de agir. Estudo, não é recomendação.")
alertcondition(sinalS, "PUT — confluência + portões",  "QUANT OPS: sinal de PUT em {{ticker}} ({{interval}}) — confira o semáforo antes de agir. Estudo, não é recomendação.")
alertcondition(sinalL and selo == "A", "CALL nível A (o melhor)", "QUANT OPS: CALL NÍVEL A em {{ticker}} ({{interval}}) — todos os portões fechados. Estudo, não é recomendação.")
alertcondition(sinalS and selo == "A", "PUT nível A (o melhor)",  "QUANT OPS: PUT NÍVEL A em {{ticker}} ({{interval}}) — todos os portões fechados. Estudo, não é recomendação.")
alertcondition(divAlta,  "Divergência de alta (RSI)",  "QUANT OPS: divergência de ALTA em {{ticker}} ({{interval}}).")
alertcondition(divBaixa, "Divergência de baixa (RSI)", "QUANT OPS: divergência de BAIXA em {{ticker}} ({{interval}}).")
